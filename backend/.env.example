# ============ Asscher AI Backend — Environment ============

# PostgreSQL connection string (Neon / Supabase / Railway / local)
DATABASE_URL="postgresql://user:password@host:5432/asscher_ai?sslmode=require"

# Port the API listens on (Render sets PORT automatically)
PORT=4000

# Comma-separated list of allowed frontend origins (your Vercel URL).
# Example: https://asscher-ai.vercel.app,https://ops.asscher.ai
FRONTEND_ORIGIN=http://localhost:5173

# Secret passphrase used to encrypt vault passwords at rest (AES-256-GCM).
# Set this ONCE and never change it, or previously stored vault passwords
# will become unreadable. Use a long random string.
VAULT_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Initial Primary Admin account (created on first boot if no users exist)
SEED_ADMIN_NAME=Primary Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@asscher.ai
SEED_ADMIN_PASSWORD=ChangeMe@123

# Optional: create a small demo organisation on first boot (true/false)
SEED_DEMO_DATA=false
